POSTGRES_DB=gestion_riego
POSTGRES_USER=gestion_prod
POSTGRES_PASSWORD=CAMBIAR_POR_SECRETO_LARGO
APP_VERSION=10.2.0
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
COOKIE_SECURE=false
TZ=America/Lima
APP_MEMORY_LIMIT=768m
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
BACKUP_RETENTION_DAYS=30

AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_CRON=0 30 2 * * *
GRAFANA_ADMIN_PASSWORD=CAMBIAR_POR_SECRETO_LARGO
AUTH_MAX_INTENTOS=5
AUTH_BLOQUEO_MINUTOS=15
AUTH_ACCESS_TOKEN_MINUTOS=15
AUTH_REFRESH_TOKEN_DIAS=14

NOTIFICATIONS_GENERATION_CRON=0 15 6 * * *
NOTIFICATIONS_CLEANUP_CRON=0 45 2 * * *
NOTIFICATIONS_READ_RETENTION_DAYS=180
NOTIFICATIONS_ARCHIVED_RETENTION_DAYS=90
